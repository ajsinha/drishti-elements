  All rights reserved.

  PROPRIETARY.

  The IDE launchers of this repository: Node and Python programs started by Maven (exec-maven-plugin), so IntelliJ IDEA Community on
  Windows runs them with no bash, no Shell Script plugin, no Node plugin and no Python plugin. Not a Java project; it builds nothing.
  Run one:  mvn -f pom.xml exec:exec@<id>   (ids below; the IDE launchers are run-configs/Elements Node tests and Elements gallery server)
  Node 20+ and Python 3 on the PATH, or name them:  -Dnode=C:\tools\node\node.exe  -Dpython=C:\Python312\python.exe
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ash.elements</groupId>
  <artifactId>drishti-elements-launchers</artifactId>
  <version>0</version>
  <packaging>pom</packaging>
  <name>drishti-elements-launchers</name>
  <properties>
    <node>node</node>
    <python>python3</python>
  </properties>
  <profiles>
    <profile>
      <id>windows-python</id>
      <activation><os><family>windows</family></os></activation>
      <properties><python>python</python></properties>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version>
        <configuration>
          <workingDirectory>${project.basedir}</workingDirectory>
        </configuration>
        <executions>
          <!-- the Node tests: every tests/elements/*.test.mjs through node test -->
          <execution><id>node-tests</id><goals><goal>exec</goal></goals><configuration>
            <executable>${node}</executable>
            <arguments><argument>tools/node_tests.mjs</argument><argument>tests/elements</argument></arguments>
          </configuration></execution>
          <!-- the gallery: the repository over HTTP, http://localhost:8765/gallery/ -->
          <execution><id>gallery</id><goals><goal>exec</goal></goals><configuration>
            <executable>${python}</executable>
            <arguments><argument>-m</argument><argument>http.server</argument><argument>8765</argument></arguments>
          </configuration></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
