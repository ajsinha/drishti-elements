// Drishti Elements in VS Code: File, Open Workspace from File. The tasks and launch configurations mirror the JetBrains run
// configurations (run-configs/). Build and run in the IDE: README.md#build-and-run-in-the-ide. No Java here; Python and Node only.
{
  "folders": [ { "name": "elements", "path": "." } ],
  "extensions": {
    "recommendations": [ "ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy", "dbaeumer.vscode-eslint", "redhat.vscode-yaml" ]
  },
  "settings": {
    "python.defaultInterpreterPath": "python3",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [ "tests" ],
    "python.testing.cwd": "${workspaceFolder:elements}",
    "javascript.validate.enable": true,
    "files.exclude": { "**/__pycache__": true }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "Elements build check", "type": "shell", "command": "python3 tools/elements/build.py --check", "windows": { "command": "python tools/elements/build.py --check" }, "options": { "cwd": "${workspaceFolder:elements}" }, "problemMatcher": [] },
      { "label": "Elements build bundles", "type": "shell", "command": "python3 tools/elements/build.py", "windows": { "command": "python tools/elements/build.py" }, "options": { "cwd": "${workspaceFolder:elements}" }, "group": "build", "problemMatcher": [] },
      { "label": "Elements API docs check", "type": "shell", "command": "python3 tools/docs/elements_api.py --check", "windows": { "command": "python tools/docs/elements_api.py --check" }, "options": { "cwd": "${workspaceFolder:elements}" }, "problemMatcher": [] },
      { "label": "Elements licence headers", "type": "shell", "command": "python3 tools/license_headers.py", "windows": { "command": "python tools/license_headers.py" }, "options": { "cwd": "${workspaceFolder:elements}" }, "problemMatcher": [] },
      { "label": "Elements dist", "type": "shell", "command": "python3 tools/elements/cli.py dist", "windows": { "command": "python tools/elements/cli.py dist" }, "options": { "cwd": "${workspaceFolder:elements}" }, "problemMatcher": [] },
      { "label": "Elements Node tests", "type": "shell", "command": "node tools/node_tests.mjs tests/elements", "options": { "cwd": "${workspaceFolder:elements}" }, "group": "test", "problemMatcher": [] },
      { "label": "Elements static tests", "type": "shell", "command": "python3 -m pytest -q tests -m static", "windows": { "command": "python -m pytest -q tests -m static" }, "options": { "cwd": "${workspaceFolder:elements}" }, "group": "test", "problemMatcher": [] },
      { "label": "Elements browser tests (8 workers)", "type": "shell", "command": "python3 -m pytest -q tests -n 8", "windows": { "command": "python -m pytest -q tests -n 8" }, "options": { "cwd": "${workspaceFolder:elements}" }, "group": "test", "problemMatcher": [] },
      { "label": "Elements gallery server (port 8765)", "type": "shell", "command": "python3 -m http.server 8765", "windows": { "command": "python -m http.server 8765" }, "options": { "cwd": "${workspaceFolder:elements}" }, "isBackground": true, "problemMatcher": [] }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      { "name": "Elements build bundles", "type": "debugpy", "request": "launch", "program": "${workspaceFolder:elements}/tools/elements/build.py", "cwd": "${workspaceFolder:elements}", "console": "integratedTerminal" },
      { "name": "Elements pytest (current file)", "type": "debugpy", "request": "launch", "module": "pytest", "args": [ "-q", "${file}" ], "cwd": "${workspaceFolder:elements}", "console": "integratedTerminal" },
      { "name": "Elements pytest (static)", "type": "debugpy", "request": "launch", "module": "pytest", "args": [ "-q", "tests", "-m", "static" ], "cwd": "${workspaceFolder:elements}", "console": "integratedTerminal" },
      { "name": "Elements gallery server", "type": "debugpy", "request": "launch", "module": "http.server", "args": [ "8765" ], "cwd": "${workspaceFolder:elements}", "console": "integratedTerminal" },
      { "name": "Elements Node test (current file)", "type": "node", "request": "launch", "program": "${file}", "runtimeArgs": [ "--test" ], "cwd": "${workspaceFolder:elements}", "console": "integratedTerminal" }
    ]
  }
}
